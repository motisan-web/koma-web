Options -Indexes

# 公開しないファイル・フォルダ（#I-011）
# 旧ドキュメントフォルダ .claude-codex は本番に残るため、移行後も塞いだままにする
RedirectMatch 404 /\.(git|github|claude|claude-codex|ai-docs)(/|$)
RedirectMatch 404 ^/(data|logs)(/|$)
RedirectMatch 404 \.(md|log|yml|yaml|zip|pj)$
RedirectMatch 404 /\.(gitignore|user\.ini|ftp-deploy-sync-state\.json)$
RedirectMatch 404 /config\.local\.php$

# 見た目モック（#T-007）はローカル専用。デプロイ対象外だが、念のため .local 以外では 404
<If "! %{HTTP_HOST} =~ /\.local(:\d+)?$/">
    RedirectMatch 404 ^/mock(/|$)
</If>
